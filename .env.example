# Configure exactly one provider and install its optional dependency.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional model override (otherwise provider defaults from llm.py are used).
# LLM_MODEL=gemini-2.5-flash

# Set true to pause risky actions for a real human decision.
LANGGRAPH_INTERRUPT=false

# Persistence and logging defaults.
CHECKPOINTER=memory
# DATABASE_URL=outputs/checkpoints.sqlite
LOG_LEVEL=INFO
